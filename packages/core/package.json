{
  "name": "@sofereditor/core",
  "version": "0.1.0",
  "description": "@sofereditor/core — Y.js-backed document model: blocks, marks, commands, history. Framework-agnostic foundation of the Sofer editor.",
  "license": "AGPL-3.0-or-later",
  "author": "Rafael Marreca",
  "homepage": "https://github.com/rafael145a/sofer/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafael145a/sofer.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rafael145a/sofer/issues"
  },
  "keywords": [
    "editor",
    "rich-text",
    "yjs",
    "crdt",
    "document-model",
    "sofer"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
