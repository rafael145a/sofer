{
  "name": "@sofer/export-docx",
  "version": "0.0.0",
  "description": "@sofer/export-docx — Emit .docx from a Sofer SerializedDocument. Round-trip with @sofer/import-docx.",
  "license": "AGPL-3.0-or-later",
  "author": "Alef Peretz",
  "homepage": "https://github.com/rafael145a/sofer/tree/main/packages/export-docx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafael145a/sofer.git",
    "directory": "packages/export-docx"
  },
  "bugs": {
    "url": "https://github.com/rafael145a/sofer/issues"
  },
  "keywords": [
    "editor",
    "docx",
    "export",
    "ooxml",
    "word",
    "sofer"
  ],
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sofer/core": "workspace:*",
    "docx": "^9.6.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
