{
  "name": "@sofereditor/import-docx",
  "version": "0.1.0",
  "description": "@sofereditor/import-docx — Parse .docx (OOXML) in browser or Node into a SerializedDocument loadable by the Sofer editor.",
  "license": "AGPL-3.0-or-later",
  "author": "Rafael Marreca",
  "homepage": "https://github.com/rafael145a/sofer/tree/main/packages/import-docx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafael145a/sofer.git",
    "directory": "packages/import-docx"
  },
  "bugs": {
    "url": "https://github.com/rafael145a/sofer/issues"
  },
  "keywords": [
    "editor",
    "docx",
    "import",
    "ooxml",
    "word",
    "sofer"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sofereditor/core": "workspace:*",
    "fast-xml-parser": "^4.5.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@sofereditor/export-docx": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
