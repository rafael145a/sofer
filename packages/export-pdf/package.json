{
  "name": "@sofereditor/export-pdf",
  "version": "0.2.0",
  "description": "@sofereditor/export-pdf \u2014 Serialize the paginated Sofer DOM to self-contained HTML, ready for Puppeteer PDF rendering.",
  "license": "AGPL-3.0-or-later",
  "author": "Rafael Marreca",
  "homepage": "https://github.com/rafael145a/sofer/tree/main/packages/export-pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafael145a/sofer.git",
    "directory": "packages/export-pdf"
  },
  "bugs": {
    "url": "https://github.com/rafael145a/sofer/issues"
  },
  "keywords": [
    "editor",
    "pdf",
    "export",
    "puppeteer",
    "sofer"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sofereditor/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
