{
  "name": "@sofereditor/collab",
  "version": "0.5.0",
  "description": "@sofereditor/collab — Hocuspocus binding for real-time collaboration with the Sofer editor. Bidirectional Y.Doc sync + awareness.",
  "license": "AGPL-3.0-or-later",
  "author": "Rafael Marreca",
  "homepage": "https://github.com/rafael145a/sofer/tree/main/packages/collab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafael145a/sofer.git",
    "directory": "packages/collab"
  },
  "bugs": {
    "url": "https://github.com/rafael145a/sofer/issues"
  },
  "keywords": [
    "editor",
    "collaboration",
    "crdt",
    "yjs",
    "hocuspocus",
    "sofer"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@sofereditor/core": "workspace:*",
    "@hocuspocus/provider": "^3.4.4",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
